use Test;
use Samaki::Page;
use Samaki::Conf;
use Samaki::Plugins;

%*ENV<SAMAKI_CONF>:delete;

# Load the planets example
my $planets-file = $*CWD.child('eg').child('planets.samaki');
skip-rest "planets.samaki not found" unless $planets-file.e;

my $content = $planets-file.slurp;

my $page = Samaki::Page.new(
  name => 'planets',
  wkdir => $*CWD.child('eg')
);

my $conf-file = $*CWD.child('resources').child('samaki-conf-default.raku');
my $conf = Samaki::Conf.new: :file($conf-file);
my $plugins = Samaki::Plugins.new;
$plugins.configure($conf);

ok $page.load($content, :$plugins), 'loaded planets page';
nok $page.errors, 'no errors loading planets';
is $page.cells.elems, 2, 'has two cells';

# Check cell types
is $page.cells[0].cell-type, 'duck', 'first cell is duck';
is $page.cells[1].cell-type, 'bash', 'second cell is bash';

# Check cell names
is $page.cells[0].name, 'earth', 'first cell named earth';
is $page.cells[1].name, 'vogon', 'second cell named vogon';

# Check cell extensions
is $page.cells[0].ext, 'csv', 'first cell ext is csv';
is $page.cells[1].ext, 'txt', 'second cell ext is txt';

# Check cell contents
ok $page.cells[0].content.contains('earth'), 'first cell contains earth query';
ok $page.cells[1].content.contains('hyperspace bypass'), 'second cell contains vogon announcement';

# Test raw mode - should show the eval snippet markers
$page.mode = 'raw';
my $raw-bash = $page.cells[1].get-content(:mode<raw>, :$page);
ok $raw-bash.contains('〈'), 'raw mode shows eval snippet markers';
ok $raw-bash.contains("cells('earth')"), 'raw mode shows cell reference';
ok $raw-bash.contains('<planet>'), 'raw mode shows column reference';

# Check if duckdb is available to test actual execution
my $duck-available = try {
  my $version = qqx[duckdb --version 2>/dev/null];
  $version.chars > 0;
}

if $duck-available {
  # Execute the first cell (earth query) to generate output
  my $duck-plugin = $page.cells[0].plugin;
  if $duck-plugin {
    my $out-file = $page.cells[0].output-file(:create);
    my $out = $out-file.open(:w);
    lives-ok {
      $duck-plugin.execute(:cell($page.cells[0]), :$page, :mode<eval>, :$out);
      $out.close;
    }, 'executed earth cell';

    # Check that output file was created
    ok $out-file.e, 'earth cell created output file';

    # Now try to get the evaluated content of the bash cell
    my $eval-result = $page.cells[1].get-content(:mode<eval>, :$page);
    ok $eval-result.contains('earth'), 'eval mode interpolated earth value';
    nok $eval-result.contains('〈'), 'eval mode does not show snippet markers';

    # Clean up
    $out-file.unlink if $out-file.e;
  } else {
    skip 'duck plugin not available', 4;
  }
} else {
  skip 'duckdb not available', 4;
}

done-testing;
